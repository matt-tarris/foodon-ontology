{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{serve.py,build/**,config/**,web/**,data/index.json,data/mined-classified.json,data/repairs-classified.json,data/resolution-store.json}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
